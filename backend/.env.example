# Kissan DB Provider (Supabase)
KISSAN_DB_PROVIDER_URL=your-supabase-url
KISSAN_DB_SERVICE_KEY=your-supabase-service-role-key
KISSAN_DB_JWT_SECRET=your-supabase-jwt-secret

# External API Endpoints
KISSAN_METEO_SOURCE_URL=https://archive-api.open-meteo.com/v1/archive
KISSAN_SOIL_DATA_SOURCE_URL=https://rest.isric.org/soilgrids/v2.0/properties/query
KISSAN_NASA_POWER_SOURCE_URL=https://power.larc.nasa.gov/api/temporal/daily/point
KISSAN_GEO_NOMINATIM_SOURCE_URL=https://nominatim.openstreetmap.org/reverse

# Security & CORS
KISSAN_API_CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]
KISSAN_API_RATE_LIMIT=100

# Identity & Auth (NextAuth Shared Secrets)
KISSAN_AUTH_ENCRYPTION_SECRET=your-nextauth-encryption-secret
KISSAN_GOOGLE_AUTH_CLIENT_ID=your-google-client-id
KISSAN_GOOGLE_AUTH_CLIENT_SECRET=your-google-client-secret

# Specialized APIs
KISSAN_GEE_PROJECT_ID=your-gee-project-id
GEMINI_API_KEY=your-gemini-api-key
